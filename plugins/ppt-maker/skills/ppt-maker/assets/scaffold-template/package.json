{
  "name": "ppt-maker-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "export:pptx": "tsx scripts/export-pptx.ts",
    "verify:geometry": "tsx scripts/verify-geometry.ts",
    "validate": "tsx scripts/validate-deck.ts",
    "check": "npm run typecheck && npm run validate && npm run export:pptx && npm run verify:geometry",
    "export:pdf": "tsx scripts/export-pdf.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.49.0",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
